  "keywords": [
    "dsh",
    "dsh-plugin",
    "handoff",
    "context",
    "session"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "state.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test-state.mjs && node test-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
